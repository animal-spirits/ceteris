{
  "permissions": {
    "ask": [
      "Edit(/tests/golden/**)",
      "Write(/tests/golden/**)",
      "Edit(/python/ceteris/packs/sources.toml)",
      "Edit(/clippy.toml)",
      "Edit(/rust-toolchain.toml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rustfmt.sh" }
        ]
      }
    ]
  }
}
