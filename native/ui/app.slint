import { AboutSlint, ScrollView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Action, Toggle } from "widgets.slint";
import "fonts/IBMPlexSansCondensed-Regular.ttf";
import "fonts/IBMPlexSansCondensed-SemiBold.ttf";
import "fonts/IBMPlexMono-Regular.ttf";
import "fonts/SourceSerif4-Regular.ttf";
import "fonts/SourceSerif4-Semibold.ttf";

export { Tokens }

export struct MapLabel {
    text: string,
    // Centre, in logical pixels of the map area.
    x: length,
    y: length,
    country: bool,
}

export struct LegendItem {
    colour: color,
    label: string,
}

export struct Row {
    key: string,
    value: string,
    number: bool,
}

component Panel inherits Rectangle {
    background: Tokens.paper;
    border-color: Tokens.rule;
    border-width: Tokens.hairline;
}

component Heading inherits Text {
    font-family: Tokens.serif;
    font-weight: 600;
    font-size: Tokens.body-size * 1.25;
    color: Tokens.ink;
}

component About inherits Panel {
    callback close();
    width: 360px;
    height: 300px;
    VerticalLayout {
        padding: Tokens.pad * 2;
        spacing: Tokens.pad;
        Heading { text: "Ceteris Paribus"; }
        Text {
            text: "Deterministic, forkable world simulator from 1 January 2000.";
            color: Tokens.ink;
            wrap: word-wrap;
        }
        AboutSlint { }
        Action {
            text: "Close";
            clicked => { root.close(); }
        }
    }
}

// Every attribute of one province (DESIGN 20.2, province inspector).
component Inspector inherits Panel {
    in property <string> title;
    in property <[Row]> rows;
    callback close();
    VerticalLayout {
        padding: Tokens.pad;
        spacing: Tokens.pad / 2;
        HorizontalLayout {
            spacing: Tokens.pad;
            Heading {
                text: root.title;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            Action {
                text: "Close";
                clicked => { root.close(); }
            }
        }
        ScrollView {
            VerticalLayout {
                padding-right: Tokens.pad * 2;
                for row in root.rows: HorizontalLayout {
                    spacing: Tokens.pad;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Text {
                        text: row.key;
                        color: Tokens.ink;
                        opacity: 0.7;
                        wrap: word-wrap;
                        width: 45%;
                    }
                    Text {
                        text: row.value;
                        font-family: row.number ? Tokens.mono : Tokens.sans;
                        color: Tokens.ink;
                        wrap: word-wrap;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Ceteris Paribus";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Tokens.sea;
    default-font-family: Tokens.sans;
    default-font-size: Tokens.body-size;

    // The map pass renders into this texture each frame (ADR 0088).
    in property <image> map-texture;
    in property <string> status;
    in property <[MapLabel]> labels;
    in property <string> legend-title;
    in property <[LegendItem]> legend;
    in property <string> legend-note;
    in property <string> inspector-title;
    in property <[Row]> inspector;
    in property <bool> inspector-open;
    in property <string> error;
    in-out property <bool> about-open;
    // Index into the mode buttons; resource group 0 is all groups.
    in-out property <int> mode;
    in-out property <int> resource-group;
    out property <length> map-width: map.width;
    out property <length> map-height: map.height;

    // Pointer positions in logical pixels of the map area.
    callback pan(length, length);
    callback zoom(length, length, length);
    callback select(length, length);
    callback hover(length, length);
    callback unhover();
    callback globe(bool);
    callback counties(bool);
    callback mode-changed();
    callback ui-scale(float);
    callback dismiss-error();
    callback close-inspector();

    MenuBar {
        Menu {
            title: "Ceteris";
            MenuItem {
                title: "About Ceteris Paribus";
                activated => { root.about-open = true; }
            }
        }
        Menu {
            title: "View";
            for scale in [85, 100, 125, 150, 175, 200]: MenuItem {
                title: "UI scale " + scale + "%";
                activated => { root.ui-scale(scale / 100); }
            }
        }
    }

    map := Image {
        source: root.map-texture;
        width: 100%;
        height: 100%;
        image-fit: fill;

        for item in root.labels: Text {
            x: item.x - self.width / 2;
            y: item.y - self.height / 2;
            text: item.text;
            color: Tokens.ink;
            font-family: Tokens.serif;
            font-size: (item.country ? 12px : 11px) * Tokens.scale;
            font-weight: item.country ? 600 : 400;
            letter-spacing: item.country ? 1.5px * Tokens.scale : 0px;
            stroke: Tokens.paper;
            stroke-width: 2px * Tokens.scale;
            stroke-style: outside;
        }

        property <length> last-x;
        property <length> last-y;
        property <bool> dragged;
        touch := TouchArea {
            mouse-cursor: self.pressed && dragged ? grabbing : default;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    last-x = self.mouse-x;
                    last-y = self.mouse-y;
                    dragged = false;
                }
            }
            moved => {
                root.pan(self.mouse-x - last-x, self.mouse-y - last-y);
                dragged = dragged || abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 3px;
                last-x = self.mouse-x;
                last-y = self.mouse-y;
            }
            clicked => {
                if !dragged {
                    root.select(self.mouse-x, self.mouse-y);
                }
            }
            scroll-event(e) => {
                root.zoom(self.mouse-x, self.mouse-y, e.delta-y);
                accept
            }
            changed mouse-x => { if self.has-hover && !self.pressed { root.hover(self.mouse-x, self.mouse-y); } }
            changed mouse-y => { if self.has-hover && !self.pressed { root.hover(self.mouse-x, self.mouse-y); } }
            changed has-hover => { if !self.has-hover { root.unhover(); } }
        }
    }

    // Mode picker and view toggles.
    picker-panel := Panel {
        x: Tokens.pad;
        y: Tokens.pad;
        width: picker.preferred-width;
        height: picker.preferred-height;
        picker := VerticalLayout {
            padding: Tokens.pad / 2;
            spacing: Tokens.pad / 2;
            HorizontalLayout {
                spacing: Tokens.pad / 2;
                for name[k] in ["Political", "Terrain", "Resources", "Freight cost"]: Toggle {
                    text: name;
                    checkable: false;
                    checked: root.mode == k;
                    clicked => {
                        root.mode = k;
                        root.mode-changed();
                    }
                }
                Rectangle { width: Tokens.pad; }
                Toggle {
                    text: "Counties";
                    clicked => { root.counties(self.checked); }
                }
                Toggle {
                    text: "Globe";
                    clicked => { root.globe(self.checked); }
                }
            }
            if root.mode == 2: HorizontalLayout {
                spacing: Tokens.pad / 2;
                alignment: start;
                for name[g] in ["all groups", "precious", "base", "ferrous", "energy", "industrial"]: Toggle {
                    text: name;
                    checkable: false;
                    checked: root.resource-group == g;
                    clicked => {
                        root.resource-group = g;
                        root.mode-changed();
                    }
                }
            }
        }
    }

    // The pointer's place, bottom left, with the legend above it.
    status := Panel {
        x: Tokens.pad;
        y: parent.height - self.height - Tokens.pad;
        // Half the window at most, so the legend and the inspector never overlap.
        width: min(Tokens.body-size * 24, (parent.width - 3 * Tokens.pad) / 2);
        height: place.preferred-height;
        visible: root.status != "";
        place := HorizontalLayout {
            padding: Tokens.pad / 2;
            padding-left: Tokens.pad;
            padding-right: Tokens.pad;
            Text {
                text: root.status;
                color: Tokens.ink;
                overflow: elide;
            }
        }
    }

    // Placed by hand: layouts measure wrapped text and repeated rows short here.
    Panel {
        property <length> row-height: Tokens.body-size * 1.6;
        property <length> rows-top: Tokens.pad + heading.preferred-height + Tokens.pad / 2;
        property <length> note-top: rows-top + root.legend.length * row-height;
        x: Tokens.pad;
        y: status.y - self.height - Tokens.pad / 2;
        width: status.width;
        height: note-top + (root.legend-note == "" ? 0 : note.preferred-height) + Tokens.pad;
        heading := Heading {
            x: Tokens.pad;
            y: Tokens.pad;
            text: root.legend-title;
        }
        for item[k] in root.legend: Rectangle {
            x: Tokens.pad;
            y: rows-top + k * row-height;
            width: parent.width - 2 * Tokens.pad;
            height: row-height;
            Rectangle {
                x: 0;
                width: Tokens.body-size;
                height: Tokens.body-size;
                background: item.colour;
                border-color: Tokens.rule;
                border-width: Tokens.hairline;
            }
            Text {
                x: Tokens.body-size + Tokens.pad;
                text: item.label;
                color: Tokens.ink;
            }
        }
        note := Text {
            x: Tokens.pad;
            y: note-top;
            width: parent.width - 2 * Tokens.pad;
            text: root.legend-note;
            color: Tokens.ink;
            opacity: 0.7;
            wrap: word-wrap;
        }
    }

    if root.inspector-open: Inspector {
        x: parent.width - self.width - Tokens.pad;
        y: picker-panel.y + picker-panel.height + Tokens.pad;
        width: min(Tokens.body-size * 26, (parent.width - 3 * Tokens.pad) / 2);
        height: parent.height - self.y - Tokens.pad;
        title: root.inspector-title;
        rows: root.inspector;
        close => { root.close-inspector(); }
    }

    if root.error != "": Panel {
        x: (parent.width - self.width) / 2;
        y: Tokens.pad;
        width: min(parent.width - 2 * Tokens.pad, Tokens.body-size * 48);
        height: banner.preferred-height;
        border-color: Tokens.ink;
        border-width: 2px;
        banner := HorizontalLayout {
            padding: Tokens.pad;
            spacing: Tokens.pad;
            Text {
                text: root.error;
                color: Tokens.ink;
                font-weight: 600;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            Action {
                text: "Dismiss";
                clicked => { root.dismiss-error(); }
            }
        }
    }

    if root.about-open: About {
        close => { root.about-open = false; }
    }
}
