import { AboutSlint, ScrollView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Action, Toggle } from "widgets.slint";
import "fonts/IBMPlexSansCondensed-Regular.ttf";
import "fonts/IBMPlexSansCondensed-SemiBold.ttf";
import "fonts/IBMPlexMono-Regular.ttf";
import "fonts/SourceSerif4-Regular.ttf";
import "fonts/SourceSerif4-Semibold.ttf";

export { Tokens }

export struct MapLabel {
    text: string,
    // Centre, in logical pixels of the map area.
    x: length,
    y: length,
    country: bool,
}

export struct LegendItem {
    colour: color,
    label: string,
}

export struct Row {
    key: string,
    value: string,
    number: bool,
    heading: bool,
}

export struct BranchRow {
    id: string,
    label: string,
    depth: int,
    current: bool,
}

export struct SetupRow {
    name: string,
    licence: string,
    size: string,
    status: string,
    manual-page: string,
    ready: bool,
    optional: bool,
}

component Panel inherits Rectangle {
    background: Tokens.paper;
    border-color: Tokens.rule;
    border-width: Tokens.hairline;
}

component Heading inherits Text {
    font-family: Tokens.serif;
    font-weight: 600;
    font-size: Tokens.body-size * 1.25;
    color: Tokens.ink;
}

component About inherits Panel {
    callback close();
    width: 360px;
    height: 300px;
    VerticalLayout {
        padding: Tokens.pad * 2;
        spacing: Tokens.pad;
        Image {
            source: @image-url("../assets/identity/svg/wordmark-horizontal-day.svg");
            height: Tokens.body-size * 1.4;
            image-fit: contain;
            horizontal-alignment: left;
            accessible-label: "Ceteris Paribus";
        }
        Text {
            text: "Deterministic, forkable world simulator from 1 January 2000.";
            color: Tokens.ink;
            wrap: word-wrap;
        }
        AboutSlint { }
        Action {
            text: "Close";
            clicked => { root.close(); }
        }
    }
}

// Every attribute of one province (DESIGN 20.2, province inspector).
component Inspector inherits Panel {
    in property <string> title;
    in property <[Row]> rows;
    callback close();
    VerticalLayout {
        padding: Tokens.pad;
        spacing: Tokens.pad / 2;
        HorizontalLayout {
            spacing: Tokens.pad;
            Heading {
                text: root.title;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            Action {
                text: "Close";
                clicked => { root.close(); }
            }
        }
        ScrollView {
            VerticalLayout {
                padding-right: Tokens.pad * 2;
                for row in root.rows: HorizontalLayout {
                    spacing: Tokens.pad;
                    padding-top: row.heading ? Tokens.pad : 2px;
                    padding-bottom: 2px;
                    Text {
                        text: row.key;
                        color: Tokens.ink;
                        opacity: row.heading ? 1 : 0.7;
                        font-weight: row.heading ? 600 : 400;
                        wrap: word-wrap;
                        width: root.width * (row.heading ? 0.85 : 0.35);
                    }
                    Text {
                        text: row.value;
                        font-family: row.number ? Tokens.mono : Tokens.sans;
                        color: Tokens.ink;
                        wrap: word-wrap;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }
}

// W1: the tree of branches, the cursor, the registry command line and the edit log. Every
// button sends a registry line (ADR 0188); the field takes a branch id or a tick for them, or a whole line on Enter. Edit takes `state|param|policy target value` and applies it at the cursor.
component Branches inherits Panel {
    in property <[BranchRow]> rows;
    in property <[string]> log;
    in property <string> branch;
    in property <int> cursor;
    in property <string> hash;
    in property <string> error;
    callback command(string);
    callback close();
    callback done();
    VerticalLayout {
        padding: Tokens.pad;
        spacing: Tokens.pad / 2;
        HorizontalLayout {
            spacing: Tokens.pad;
            Heading {
                text: "Branches";
                vertical-alignment: center;
            }
            Action {
                text: "Close";
                clicked => { root.close(); }
            }
        }
        Text {
            text: root.branch == "" ? "no branch session" : root.branch + " at tick " + root.cursor;
            font-family: Tokens.mono;
            color: Tokens.ink;
            overflow: elide;
        }
        Text {
            text: root.hash;
            font-family: Tokens.mono;
            color: Tokens.ink;
            opacity: 0.7;
            overflow: elide;
        }
        if root.error != "": Text {
            text: root.error;
            color: Tokens.edit;
            font-weight: 600;
            wrap: word-wrap;
        }
        ScrollView {
            min-height: Tokens.body-size * 1.8 * 4;
            VerticalLayout {
                for row in root.rows: Rectangle {
                    height: Tokens.body-size * 1.8;
                    background: row.current ? Tokens.fork : touch.has-hover ? Tokens.rule : transparent;
                    accessible-role: button;
                    accessible-label: row.id;
                    accessible-action-default => { touch.clicked(); }
                    HorizontalLayout {
                        padding-left: Tokens.pad / 2 + row.depth * Tokens.pad * 1.5;
                        spacing: Tokens.pad;
                        Text {
                            text: row.id;
                            font-weight: 600;
                            color: row.current ? Tokens.paper : Tokens.ink;
                            vertical-alignment: center;
                        }
                        Text {
                            text: row.label;
                            font-family: Tokens.mono;
                            color: row.current ? Tokens.paper : Tokens.ink;
                            opacity: 0.8;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.command("branch.switch " + row.id); }
                    }
                }
            }
        }
        Rectangle {
            height: Tokens.body-size * 1.9;
            border-color: Tokens.rule;
            border-width: Tokens.hairline;
            Text {
                x: Tokens.pad / 2;
                text: "id or tick; Enter sends a registry line";
                color: Tokens.ink;
                opacity: 0.45;
                vertical-alignment: center;
                visible: field.text == "";
            }
            field := TextInput {
                x: Tokens.pad / 2;
                width: parent.width - Tokens.pad;
                font-family: Tokens.mono;
                color: Tokens.ink;
                vertical-alignment: center;
                accessible-label: "Branch command";
                accepted => {
                    root.command(self.text);
                    self.text = "";
                    root.done();
                }
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.done();
                        return accept;
                    }
                    reject
                }
            }
        }
        HorizontalLayout {
            spacing: Tokens.pad / 2;
            alignment: start;
            Action {
                text: "Fork here";
                clicked => { root.command("branch.fork " + field.text); }
            }
            Action {
                text: "Seek";
                clicked => { root.command("time.seek " + field.text); }
            }
            Action {
                text: "Edit";
                clicked => { root.command("branch.edit " + field.text); }
            }
            Action {
                text: "Run to";
                clicked => { root.command("time.run-to " + field.text); }
            }
        }
        Heading {
            text: "Edit log";
        }
        ScrollView {
            VerticalLayout {
                padding-right: Tokens.pad * 2;
                for line in root.log: Text {
                    text: line;
                    font-family: Tokens.mono;
                    color: Tokens.ink;
                    wrap: word-wrap;
                }
                if root.log.length == 0: Text {
                    text: "no edits on this branch";
                    color: Tokens.ink;
                    opacity: 0.7;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Ceteris Paribus";
    icon: @image-url("../assets/identity/icons/icon-carved-night-256.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Tokens.sea;
    default-font-family: Tokens.sans;
    default-font-size: Tokens.body-size;

    // The map pass renders into this texture each frame (ADR 0088).
    in property <image> map-texture;
    in property <string> status;
    in property <[MapLabel]> labels;
    in property <string> legend-title;
    in property <[LegendItem]> legend;
    in property <string> legend-note;
    in property <string> inspector-title;
    in property <[Row]> inspector;
    in property <bool> inspector-open;
    in property <string> error;
    in property <bool> halt-open;
    in property <string> halt-title;
    in property <string> halt-detail;
    in property <string> halt-folder;
    in-out property <bool> about-open;
    in-out property <bool> branches-open;
    in property <[BranchRow]> branch-rows;
    in property <[string]> branch-log;
    in property <string> branch-name;
    in property <int> branch-cursor;
    in property <string> branch-hash;
    in property <string> branch-error;
    callback branch-command(string);
    // Index into the mode buttons; resource group 0 is all groups.
    in-out property <int> mode;
    in-out property <int> resource-group;
    // The good of the price, output and net exports modes.
    in-out property <int> good;
    out property <length> map-width: map.width;
    out property <length> map-height: map.height;

    // Pointer positions in logical pixels of the map area.
    callback pan(length, length);
    callback zoom(length, length, length);
    callback select(length, length);
    callback hover(length, length);
    callback unhover();
    callback counties(bool);
    callback mode-changed();
    callback ui-scale(float);
    callback dismiss-error();
    callback dismiss-halt();
    callback open-bundle();
    callback report-problem();
    callback close-inspector();
    // Registry commands by name, and key events for the keymap (ADR 0188).
    callback command(string);
    callback key(string, bool, bool, bool) -> bool;

    // Time controls (ADRs 0208, 0232).
    in property <bool> running;
    in property <string> date;
    in property <int> tick;
    in property <bool> playing;
    in property <int> speed;
    in property <bool> sim-bound;

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if root.key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift) {
                return accept;
            }
            reject
        }
    }

    MenuBar {
        Menu {
            title: "Ceteris";
            MenuItem {
                title: "About Ceteris Paribus";
                activated => { root.about-open = true; }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Branches";
                activated => { root.command("view.branches"); }
            }
            for scale in [85, 100, 125, 150, 175, 200]: MenuItem {
                title: "UI scale " + scale + "%";
                activated => { root.ui-scale(scale / 100); }
            }
        }
    }

    map := Image {
        source: root.map-texture;
        width: 100%;
        height: 100%;
        image-fit: fill;

        for item in root.labels: Text {
            x: item.x - self.width / 2;
            y: item.y - self.height / 2;
            text: item.text;
            color: Tokens.ink;
            font-family: Tokens.serif;
            font-size: (item.country ? 12px : 11px) * Tokens.scale;
            font-weight: item.country ? 600 : 400;
            letter-spacing: item.country ? 1.5px * Tokens.scale : 0px;
            stroke: Tokens.paper;
            stroke-width: 2px * Tokens.scale;
            stroke-style: outside;
        }

        property <length> last-x;
        property <length> last-y;
        property <bool> dragged;
        touch := TouchArea {
            mouse-cursor: self.pressed && dragged ? grabbing : default;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    keys.focus();
                    last-x = self.mouse-x;
                    last-y = self.mouse-y;
                    dragged = false;
                }
            }
            moved => {
                root.pan(self.mouse-x - last-x, self.mouse-y - last-y);
                dragged = dragged || abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 3px;
                last-x = self.mouse-x;
                last-y = self.mouse-y;
            }
            clicked => {
                if !dragged {
                    root.select(self.mouse-x, self.mouse-y);
                }
            }
            scroll-event(e) => {
                root.zoom(self.mouse-x, self.mouse-y, e.delta-y);
                accept
            }
            changed mouse-x => { if self.has-hover && !self.pressed { root.hover(self.mouse-x, self.mouse-y); } }
            changed mouse-y => { if self.has-hover && !self.pressed { root.hover(self.mouse-x, self.mouse-y); } }
            changed has-hover => { if !self.has-hover { root.unhover(); } }
        }
    }

    // Mode picker and view toggles.
    picker-panel := Panel {
        x: Tokens.pad;
        y: Tokens.pad;
        width: picker.preferred-width;
        height: picker.preferred-height;
        picker := VerticalLayout {
            padding: Tokens.pad / 2;
            spacing: Tokens.pad / 2;
            HorizontalLayout {
                spacing: Tokens.pad / 2;
                alignment: start;
                for name[k] in ["Political", "Terrain", "Resources", "Freight cost"]: Toggle {
                    text: name;
                    checkable: false;
                    checked: root.mode == k;
                    clicked => {
                        root.mode = k;
                        root.mode-changed();
                    }
                }
                Rectangle { width: Tokens.pad; }
                Toggle {
                    text: "Counties";
                    clicked => { root.counties(self.checked); }
                }
            }
            HorizontalLayout {
                spacing: Tokens.pad / 2;
                alignment: start;
                for name[k] in ["Price", "Output", "Net exports", "Wage", "Unemployment"]: Toggle {
                    text: name;
                    checkable: false;
                    checked: root.mode == k + 4;
                    clicked => {
                        root.mode = k + 4;
                        root.mode-changed();
                    }
                }
            }
            if root.mode >= 4 && root.mode <= 6: HorizontalLayout {
                spacing: Tokens.pad / 2;
                alignment: start;
                for name[g] in ["Agriculture", "Oil and gas", "Mining", "Food", "Light mfg", "Chemicals", "Machinery", "Utilities", "Construction", "Services"]: Toggle {
                    text: name;
                    checkable: false;
                    checked: root.good == g;
                    clicked => {
                        root.good = g;
                        root.mode-changed();
                    }
                }
            }
            if root.mode == 2: HorizontalLayout {
                spacing: Tokens.pad / 2;
                alignment: start;
                for name[g] in ["all groups", "precious", "base", "ferrous", "energy", "industrial"]: Toggle {
                    text: name;
                    checkable: false;
                    checked: root.resource-group == g;
                    clicked => {
                        root.resource-group = g;
                        root.mode-changed();
                    }
                }
            }
        }
    }

    time-panel := Panel {
        x: parent.width - self.width - Tokens.pad;
        y: Tokens.pad;
        width: time.preferred-width;
        height: time.preferred-height;
        time := HorizontalLayout {
            padding: Tokens.pad / 2;
            spacing: Tokens.pad / 2;
            Action {
                // Wide enough for either label, so the panel does not jump.
                min-width: Tokens.body-size * 4;
                text: root.playing ? "Pause" : "Play";
                clicked => { root.command("time.toggle-pause"); }
            }
            for n in [1, 2, 3, 4, 5]: Toggle {
                text: n;
                checkable: false;
                checked: root.speed == n;
                clicked => { root.command("time.speed " + n); }
            }
            Action {
                text: "Step";
                clicked => { root.command("time.step"); }
            }
            Text {
                text: root.date;
                font-family: Tokens.mono;
                color: Tokens.ink;
                vertical-alignment: center;
                min-width: Tokens.body-size * 8;
                horizontal-alignment: right;
            }
            Text {
                text: root.running ? "tick " + root.tick : "";
                font-family: Tokens.mono;
                color: Tokens.ink;
                opacity: 0.7;
                vertical-alignment: center;
            }
            if root.sim-bound: Rectangle {
                background: Tokens.ink;
                min-width: chip.preferred-width + Tokens.pad;
                chip := Text {
                    text: "sim-bound";
                    color: Tokens.paper;
                }
            }
        }
    }

    // The pointer's place, bottom left, with the legend above it.
    status := Panel {
        x: Tokens.pad;
        y: parent.height - self.height - Tokens.pad;
        // Half the window at most, so the legend and the inspector never overlap.
        width: min(Tokens.body-size * 24, (parent.width - 3 * Tokens.pad) / 2);
        height: place.preferred-height;
        visible: root.status != "";
        place := HorizontalLayout {
            padding: Tokens.pad / 2;
            padding-left: Tokens.pad;
            padding-right: Tokens.pad;
            Text {
                text: root.status;
                color: Tokens.ink;
                overflow: elide;
            }
        }
    }

    // Placed by hand: layouts measure wrapped text and repeated rows short here.
    Panel {
        property <length> row-height: Tokens.body-size * 1.6;
        property <length> rows-top: Tokens.pad + heading.preferred-height + Tokens.pad / 2;
        property <length> note-top: rows-top + root.legend.length * row-height;
        x: Tokens.pad;
        y: status.y - self.height - Tokens.pad / 2;
        width: status.width;
        height: note-top + (root.legend-note == "" ? 0 : note.preferred-height) + Tokens.pad;
        heading := Heading {
            x: Tokens.pad;
            y: Tokens.pad;
            text: root.legend-title;
        }
        for item[k] in root.legend: Rectangle {
            x: Tokens.pad;
            y: rows-top + k * row-height;
            width: parent.width - 2 * Tokens.pad;
            height: row-height;
            Rectangle {
                x: 0;
                width: Tokens.body-size;
                height: Tokens.body-size;
                background: item.colour;
                border-color: Tokens.rule;
                border-width: Tokens.hairline;
            }
            Text {
                x: Tokens.body-size + Tokens.pad;
                text: item.label;
                color: Tokens.ink;
            }
        }
        note := Text {
            x: Tokens.pad;
            y: note-top;
            width: parent.width - 2 * Tokens.pad;
            text: root.legend-note;
            color: Tokens.ink;
            opacity: 0.7;
            wrap: word-wrap;
        }
    }

    // Right column: the branch manager under the time controls, the inspector under it.
    property <length> branches-top: max(picker-panel.y + picker-panel.height, time-panel.y + time-panel.height) + Tokens.pad;
    property <length> branches-height: min(Tokens.body-size * 28, (root.height - branches-top - 2 * Tokens.pad) * (root.inspector-open ? 0.55 : 1));
    if root.branches-open: Branches {
        x: parent.width - self.width - Tokens.pad;
        y: max(picker-panel.y + picker-panel.height, time-panel.y + time-panel.height) + Tokens.pad;
        width: min(Tokens.body-size * 26, (parent.width - 3 * Tokens.pad) / 2);
        height: root.branches-height;
        rows: root.branch-rows;
        log: root.branch-log;
        branch: root.branch-name;
        cursor: root.branch-cursor;
        hash: root.branch-hash;
        error: root.branch-error;
        command(line) => { root.branch-command(line); }
        close => { root.branches-open = false; }
        done => { keys.focus(); }
    }

    if root.inspector-open: Inspector {
        x: parent.width - self.width - Tokens.pad;
        y: max(picker-panel.y + picker-panel.height, time-panel.y + time-panel.height) + (root.branches-open ? root.branches-height + Tokens.pad : 0px) + Tokens.pad;
        width: min(Tokens.body-size * 26, (parent.width - 3 * Tokens.pad) / 2);
        height: parent.height - self.y - Tokens.pad;
        title: root.inspector-title;
        rows: root.inspector;
        close => { root.close-inspector(); }
    }

    if root.error != "": Panel {
        x: (parent.width - self.width) / 2;
        y: Tokens.pad;
        width: min(parent.width - 2 * Tokens.pad, Tokens.body-size * 48);
        height: banner.preferred-height;
        border-color: Tokens.ink;
        border-width: 2px;
        banner := HorizontalLayout {
            padding: Tokens.pad;
            spacing: Tokens.pad;
            Text {
                text: root.error;
                color: Tokens.ink;
                font-weight: 600;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            Action {
                text: "Dismiss";
                clicked => { root.dismiss-error(); }
            }
        }
    }

    if root.halt-open: Panel {
        x: (parent.width - self.width) / 2;
        y: Tokens.pad;
        width: min(parent.width - 2 * Tokens.pad, Tokens.body-size * 48);
        height: halt-box.preferred-height;
        border-color: Tokens.ink;
        border-width: 2px;
        halt-box := VerticalLayout {
            padding: Tokens.pad;
            spacing: Tokens.pad;
            HorizontalLayout {
                spacing: Tokens.pad;
                Image {
                    source: @image-url("../assets/mock/icons/halt.svg");
                    width: Tokens.body-size * 1.5;
                    height: self.width;
                    vertical-alignment: center;
                }
                Heading {
                    text: root.halt-title;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.halt-detail;
                color: Tokens.ink;
                wrap: word-wrap;
            }
            Text {
                text: root.halt-folder == "" ? "No bundle was written." : "Repro bundle: " + root.halt-folder;
                color: Tokens.ink;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Tokens.pad;
                alignment: end;
                Action {
                    text: "Open bundle folder";
                    clicked => { root.open-bundle(); }
                }
                Action {
                    text: "Report a problem";
                    clicked => { root.report-problem(); }
                }
                Action {
                    text: "Dismiss";
                    clicked => { root.dismiss-halt(); }
                }
            }
        }
    }

    if root.about-open: About {
        close => { root.about-open = false; }
    }
}

// First-run setup (ADR 0215, RFC 0333).
export component SetupWindow inherits Window {
    title: "Ceteris Paribus: setup";
    preferred-width: 760px;
    preferred-height: 640px;
    background: Tokens.paper;
    default-font-family: Tokens.sans;
    default-font-size: Tokens.body-size;

    in property <[SetupRow]> rows;
    in property <string> disk;
    in property <bool> disk-ok;
    in property <string> notice;
    in property <string> message;
    in property <bool> can-build;
    callback accept-file(string);
    callback build();
    callback open-page(string);

    VerticalLayout {
        padding: Tokens.pad * 2;
        spacing: Tokens.pad;
        Heading {
            text: "Setting up Ceteris Paribus";
        }
        Text {
            text: root.disk;
            color: root.disk-ok ? Tokens.ink : Tokens.edit;
            font-weight: root.disk-ok ? 400 : 600;
            wrap: word-wrap;
        }
        if root.notice != "": Text {
            text: root.notice;
            color: Tokens.fork;
            wrap: word-wrap;
        }
        ScrollView {
            VerticalLayout {
                for row in root.rows: Rectangle {
                    height: Tokens.body-size * 2.6;
                    border-color: Tokens.rule;
                    border-width: Tokens.hairline;
                    accessible-role: list-item;
                    accessible-label: row.name + ", " + row.status;
                    HorizontalLayout {
                        padding: Tokens.pad / 2;
                        spacing: Tokens.pad;
                        VerticalLayout {
                            Text {
                                text: row.name;
                                font-family: Tokens.mono;
                                color: Tokens.ink;
                                overflow: elide;
                            }
                            Text {
                                text: row.licence + (row.optional ? ", optional upgrade" : "");
                                color: Tokens.ink;
                                opacity: 0.7;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: row.size;
                            color: Tokens.ink;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                        Text {
                            text: row.status;
                            color: row.ready ? Tokens.fork : Tokens.ink;
                            font-weight: row.ready ? 600 : 400;
                            vertical-alignment: center;
                            min-width: Tokens.body-size * 12;
                            horizontal-stretch: 0;
                        }
                        if row.manual-page != "": Action {
                            text: "Open page";
                            clicked => { root.open-page(row.manual-page); }
                        }
                    }
                }
            }
        }
        Text {
            text: "Files downloaded by hand: type or paste the file's path and press Enter. It is accepted when it matches the expected checksum.";
            color: Tokens.ink;
            wrap: word-wrap;
        }
        Rectangle {
            height: Tokens.body-size * 2;
            border-color: Tokens.rule;
            border-width: Tokens.hairline;
            path := TextInput {
                x: Tokens.pad / 2;
                width: parent.width - Tokens.pad;
                font-family: Tokens.mono;
                color: Tokens.ink;
                vertical-alignment: center;
                accessible-label: "Path of a downloaded file";
                accepted => {
                    root.accept-file(self.text);
                    self.text = "";
                }
            }
        }
        if root.message != "": Text {
            text: root.message;
            color: Tokens.edit;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            Action {
                text: "Build the pack";
                opacity: root.can-build ? 1 : 0.4;
                clicked => { if root.can-build { root.build(); } }
            }
        }
    }
}
