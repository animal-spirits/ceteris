+#![allow(clippy::disallowed_methods)]
+//! SPIKE (P5 Branch E): money anchor. ANCHOR="split,krt,krl,kb,km,pie" or "cell,_,_,kb,km,pie"; unset = as built.
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::path::Path;
+use std::sync::Arc;
+
+use ceteris_core::sim::Sim;
+use ceteris_econ::anchor_spike::{ANCHOR, Anchor, BASE, money, money_shock};
+use ceteris_econ::equilibrium::Equilibrium;
+use ceteris_econ::fixture::small_world;
+use ceteris_econ::systems::{SEED, schedule};
+use ceteris_econ::{EconParams, EconWorld};
+use ceteris_trade::TradeParams;
+
+fn set_anchor() -> String {
+    let spec = std::env::var("ANCHOR").unwrap_or_default();
+    *BASE.lock().unwrap() = None;
+    *ANCHOR.lock().unwrap() = if spec.is_empty() {
+        None
+    } else {
+        let f: Vec<&str> = spec.split(',').collect();
+        let x = |i: usize| f[i].parse::<f64>().unwrap_or(0.0);
+        Some(Anchor { split: f[0] == "split", kr_traded: x(1), kr_local: x(2), kb: x(3), km: x(4), pie: f[5] == "1" })
+    };
+    spec
+}
+
+fn params() -> EconParams {
+    if std::env::var_os("DEFAULT").is_some() { EconParams::default() } else { EconParams::frictionless() }
+}
+
+#[test]
+#[ignore = "spike"]
+fn data_state() {
+    let spec = set_anchor();
+    let w = EconWorld::new(Arc::new(small_world()), params(), TradeParams::default());
+    let mut sim = Sim::new(w, schedule(), SEED);
+    let (mut max, mut at, mut i60, mut last50) = (0.0f64, 0, 0.0, 0.0f64);
+    let mut prev: Vec<f64> = vec![];
+    let mut stop = String::new();
+    let n = std::env::var("TICKS").map_or(1200, |v| v.parse().unwrap());
+    for t in 1..=n {
+        if let Err(e) = catch_unwind(AssertUnwindSafe(|| sim.run_until(t).unwrap())) {
+            stop = format!("panic at {t}: {:?}", e.downcast_ref::<String>().map(|s| &s[..s.len().min(80)]));
+            break;
+        }
+        let w = sim.world();
+        let ix = w.world_price_index();
+        if !ix.is_finite() { stop = format!("non-finite index at {t}"); break; }
+        if ix > max { (max, at) = (ix, t); }
+        if t == 60 { i60 = ix; }
+        if t > n - 50 {
+            let d = w.markets.price.iter().zip(&prev).zip(&w.markets.active)
+                .filter(|(_, a)| **a).map(|((p, q), _)| (p / q).ln().abs()).fold(0.0, f64::max);
+            last50 = last50.max(d);
+        }
+        prev = w.markets.price.clone();
+    }
+    let w = sim.world();
+    let dir = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../tests/golden/p2-fixture/reference");
+    let s = Equilibrium::read(&dir).unwrap();
+    let ix = w.world_price_index();
+    let v1p = (0..w.markets.price.len()).filter(|&c| w.markets.active[c])
+        .map(|c| (w.markets.price[c] / ix / s.price[c] - 1.0).abs()).fold(0.0, f64::max);
+    let v1w = (0..w.wage.len()).map(|i| (w.wage[i] / ix / s.wage[i] - 1.0).abs()).fold(0.0, f64::max);
+    eprintln!("RESULT [{spec}] V1 price {v1p:.2e} wage {v1w:.2e}; default={} max {max:.3} at {at}, t60 {i60:.3}, end {:.3}, last50 max|dlnp| {last50:.2e} {stop}",
+        std::env::var_os("DEFAULT").is_some(), w.world_price_index());
+}
+
+#[test]
+#[ignore = "spike"]
+fn nominal_shock() {
+    let spec = set_anchor();
+    let dir = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../tests/golden/p2-fixture/reference");
+    let s = Equilibrium::read(&dir).unwrap();
+    let mut w = EconWorld::new(Arc::new(small_world()), params(), TradeParams::default());
+    w.settle(&s);
+    let i0 = w.world_price_index();
+    // baseline first so BASE holds the pre-shock money
+    let m_before = money(&w);
+    *BASE.lock().unwrap() = Some((i0, m_before));
+    money_shock(&mut w, 0.05);
+    let target = i0 * money(&w) / m_before;
+    let mut sim = Sim::new(w, schedule(), SEED);
+    let mut inside = None;
+    let mut path = String::new();
+    for t in 1..=300 {
+        if catch_unwind(AssertUnwindSafe(|| sim.run_until(t).unwrap())).is_err() { path += &format!(" panic {t}"); break; }
+        let ix = sim.world().world_price_index();
+        let off = (ix / target).ln().abs();
+        if off < 0.01 { inside.get_or_insert(t); } else { inside = None; }
+        if [1, 5, 10, 20, 30, 60, 120, 300].contains(&t) { path += &format!(" {t}:{:.4}", ix / i0); }
+    }
+    eprintln!("RESULT [{spec}] nominal: target {:.4} enters 1% band for good at {inside:?}; I/I0{path}", target / i0);
+}
+
+#[test]
+#[ignore = "spike"]
+fn x10() {
+    let spec = set_anchor();
+    let dir = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../tests/golden/p2-fixture/reference");
+    let s = Equilibrium::read(&dir).unwrap();
+    let mut w = EconWorld::new(Arc::new(small_world()), params(), TradeParams::default());
+    w.settle(&s);
+    let nc = w.inputs().n_countries();
+    let mut wedges = ceteris_trade::network::Wedges::none(nc);
+    wedges.ntb = vec![10.0; wedges.tariff.len()];
+    w.set_wedges(wedges);
+    let mut sim = Sim::new(w, schedule(), SEED);
+    let (mut max, mut last50, mut stop) = (0.0f64, 0.0f64, String::new());
+    let mut prev: Vec<f64> = vec![];
+    for t in 1..=1200 {
+        if let Err(e) = catch_unwind(AssertUnwindSafe(|| sim.run_until(t).unwrap())) {
+            stop = format!("panic at {t}: {:?}", e.downcast_ref::<String>().map(|s| &s[..s.len().min(80)]));
+            break;
+        }
+        let w = sim.world();
+        max = max.max(w.world_price_index());
+        if t > 1150 {
+            let d = w.markets.price.iter().zip(&prev).zip(&w.markets.active)
+                .filter(|(_, a)| **a).map(|((p, q), _)| (p / q).ln().abs()).fold(0.0, f64::max);
+            last50 = last50.max(d);
+        }
+        prev = w.markets.price.clone();
+    }
+    eprintln!("RESULT [{spec}] x10 default={} max index {max:.3}, end {:.3}, last50 max|dlnp| {last50:.2e} {stop}",
+        std::env::var_os("DEFAULT").is_some(), sim.world().world_price_index());
+}
