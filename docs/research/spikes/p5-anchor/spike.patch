+//! SPIKE (P5 Branch E, not for merge): money-anchored split price rule.
+//! dlnp_o = pi^e + clip( a_o (l_o - lbar_g) + kb (lbar_g - lbar) - km (ln(I/I0) - ln(M/M0)) )
+//! l_o = (D [+ b] - Q) / Q_eff as built; a_o = cell gain (REL=cell) or kr_g / E_g (REL=split).
+use std::sync::Mutex;
+
+use crate::world::{EconWorld, to_numeraire_wide};
+
+#[derive(Clone, Copy, Debug)]
+pub struct Anchor {
+    pub split: bool,
+    pub kr_traded: f64,
+    pub kr_local: f64,
+    pub kb: f64,
+    pub km: f64,
+    pub pie: bool,
+}
+
+pub static ANCHOR: Mutex<Option<Anchor>> = Mutex::new(None);
+pub static BASE: Mutex<Option<(f64, f64)>> = Mutex::new(None);
+
+pub fn money(w: &EconWorld) -> f64 {
+    -to_numeraire_wide(w.ledger.money_wide(w.layout.accounts.mint))
+}
+
+pub fn reprice(w: &mut EconWorld, a: Anchor) {
+    let index = w.world_price_index();
+    let m = money(w);
+    let (i0, m0) = *BASE.lock().unwrap().get_or_insert((index, m));
+    let nominal = -a.km * ((index / i0).ln() - (m / m0).ln());
+    let (p, mk) = (&w.trade, &mut w.markets);
+    let ng = p.goods.n();
+    let n = mk.price.len();
+    let mut floor = vec![0.0; ng];
+    let mut count = vec![0usize; ng];
+    for i in 0..n {
+        if mk.active[i] {
+            floor[i % ng] += mk.supply[i];
+            count[i % ng] += 1;
+        }
+    }
+    for g in 0..ng {
+        floor[g] = 1e-9 * floor[g] / count[g].max(1) as f64;
+    }
+    let mut l = vec![0.0; n];
+    let (mut num, mut den) = (vec![0.0; ng], vec![0.0; ng]);
+    for i in 0..n {
+        let g = i % ng;
+        if !mk.active[i] || floor[g] <= 0.0 {
+            continue;
+        }
+        let (q, d) = (mk.supply[i], mk.demand[i]);
+        let b = if p.stores(g) { mk.storage[i] } else { 0.0 };
+        l[i] = (d + b - q) / q.max(floor[g]);
+        let v = mk.price[i] * 0.5 * (q + d);
+        num[g] += v * l[i];
+        den[g] += v;
+    }
+    let lg: Vec<f64> = (0..ng).map(|g| if den[g] > 0.0 { num[g] / den[g] } else { 0.0 }).collect();
+    let lbar = num.iter().sum::<f64>() / den.iter().sum::<f64>();
+    let pie = if a.pie { w.expected_inflation } else { 0.0 };
+    for i in 0..n {
+        let g = i % ng;
+        if !mk.active[i] || floor[g] <= 0.0 {
+            continue;
+        }
+        let rel = if a.split {
+            if p.goods.is_traded(g) { a.kr_traded / (p.theta[g] + 1.0) } else { a.kr_local }
+        } else {
+            w.layout.price_gain[i]
+        };
+        let mut gap = rel * (l[i] - lg[g]) + a.kb * (lg[g] - lbar) + nominal;
+        if p.coverage[g] > 0.0 && !p.stores(g) {
+            let target = p.coverage[g] * mk.demand[i];
+            gap -= p.kappa2 * (mk.inventory[i] - target) / target.max(floor[g]);
+        }
+        let c = p.price_clip(g);
+        if gap.abs() > c {
+            mk.clip_ticks[i] += 1;
+        }
+        let step = pie + gap.clamp(-c, c);
+        mk.price[i] *= step.exp();
+        if p.stores(g) {
+            let e = mk.expectation[i];
+            mk.expectation[i] = e + p.storage_gain * (step - e);
+        }
+    }
+}
+
+/// Mints `f` times each pop's positive balance to it (the nominal-shock test of ADR 0090).
+pub fn money_shock(w: &mut EconWorld, f: f64) {
+    let acc = &w.layout.accounts;
+    for &k in &acc.pop {
+        let b = w.ledger.money(k);
+        if b > 0 {
+            w.ledger.transfer(crate::world::MINT, acc.mint, k, (b as f64 * f) as i64);
+        }
+    }
+}
