+pub fn e3p(w: &EconWorld, tag: &str) {
+    let Ok(p) = std::env::var("E3P") else { return };
+    if tag != "pre-dist" { return; }
+    let i: usize = p.parse().unwrap();
+    let (ng, nt) = (w.inputs.n_goods(), w.inputs.goods.traded);
+    let acc = &w.layout.accounts;
+    let lay = &w.layout;
+    let mn = |a| to_numeraire(w.ledger.money(a));
+    let m = &w.markets;
+    let cash = mn(acc.market[i]);
+    let pm: f64 = lay.pops(i).map(|k| mn(acc.pop[k])).sum();
+    let em: f64 = lay.enterprises(i).map(|e| mn(acc.enterprise[e])).sum();
+    let (mut imp, mut exp, mut qv, mut sv, mut dsv) = ([0.0; 2], 0.0, 0.0, 0.0, 0.0);
+    for g in 0..nt {
+        let r = &w.scratch.sourced[g];
+        for c in 0..2 { imp[c] += r.paid_by_class[i][c]; }
+        exp += r.received[i];
+        let c = i * ng + g;
+        qv += m.price[c] * m.supply[c];
+        sv += m.price[c] * m.inventory[c];
+        dsv += m.price[c] * (m.supply[c] - m.sales[c]);
+    }
+    let lq: f64 = (nt..ng).map(|g| m.price[i * ng + g] * m.supply[i * ng + g]).sum();
+    let y: f64 = lay.enterprises(i).map(|e| w.output[e]).sum();
+    let wb: f64 = lay.enterprises(i).map(|e| w.wage[i] * w.employment[e]).sum();
+    eprintln!("E3P mkt {cash:.2e} pop {pm:.2e} ent {em:.2e} | paid_int {:.2e} paid_hh {:.2e} recv {exp:.2e} pQtr {qv:.2e} pQloc {lq:.2e} p(Q-sold) {dsv:.2e} pS {sv:.2e} | Y {y:.2e} wage {:.2} bill {wb:.2e}", imp[0], imp[1], w.wage[i]);
+}
