+++ b/crates/ceteris-econ/tests/p5_e3_d1d2.rs
@@ -0,0 +1,58 @@
+// SPIKE RFC 0341: D1 anchored stock term (KS) and D2 pay on sales (PS). Not for merge.
+use std::path::Path;
+use std::sync::Arc;
+use ceteris_core::sim::Sim;
+use ceteris_econ::equilibrium::Equilibrium;
+use ceteris_econ::fixture::small_world;
+use ceteris_econ::systems::{SEED, schedule};
+use ceteris_econ::{EconParams, EconWorld};
+use ceteris_trade::{PriceAnchor, TradeParams};
+
+fn env(k: &str, d: f64) -> f64 { std::env::var(k).ok().map(|s| s.parse().unwrap()).unwrap_or(d) }
+
+#[test]
+#[ignore]
+fn spike() {
+    let (ks, ps, ntb, ticks) = (env("KS", 0.0), env("PS", 0.0) > 0.0, env("NTB", 10.0), env("T", 700.0) as u32);
+    let anchor = PriceAnchor { kappa_s: ks, ..PriceAnchor::default() };
+    let trade = TradeParams { anchor: Some(anchor), ..TradeParams::default() };
+    let dir = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../tests/golden/p2-fixture/reference");
+    let params = EconParams { pay_on_sales: ps, ..EconParams::frictionless() };
+    let mut w = EconWorld::new(Arc::new(small_world()), params, trade);
+    w.settle(&Equilibrium::read(&dir).unwrap());
+    let y0: f64 = w.output.iter().sum();
+    let i0 = w.world_price_index();
+    if ntb != 1.0 {
+        let mut wedges = ceteris_trade::network::Wedges::none(w.inputs().n_countries());
+        wedges.ntb = vec![ntb as f32; wedges.tariff.len()];
+        w.set_wedges(wedges);
+    }
+    let mut sim = Sim::new(w, schedule(), SEED);
+    let (mut imax, mut imin, mut ymin) = (1.0f64, 1.0f64, f64::INFINITY);
+    let mut line = String::new();
+    for t in 1..=ticks {
+        sim.run_until(t).unwrap();
+        let w = sim.world();
+        let m = &w.markets;
+        let (mut pd, mut pq) = (0.0, 0.0);
+        for i in 0..m.price.len() { if m.active[i] { pd += m.price[i] * m.demand[i]; pq += m.price[i] * m.supply[i]; } }
+        let idx = w.world_price_index() / i0;
+        let y = w.output.iter().sum::<f64>() / y0;
+        if t > 20 { imax = imax.max(idx); imin = imin.min(idx); ymin = ymin.min(y); }
+        if t % 100 == 0 || t == 1 {
+            let inp = w.inputs(); let lay = w.layout(); let acc = &lay.accounts;
+            let ng = inp.n_goods();
+            // island p24: pops, enterprises, market money; its country's other provinces
+            let c24 = inp.country_of(24);
+            let pm = |i: usize| lay.pops(i).map(|k| w.ledger.money(acc.pop[k]) as f64 * 1e-4).sum::<f64>();
+            let em = |i: usize| lay.enterprises(i).map(|e| w.ledger.money(acc.enterprise[e]) as f64 * 1e-4).sum::<f64>();
+            let others: Vec<usize> = (0..inp.n_provinces()).filter(|&i| i != 24 && inp.country_of(i) == c24).collect();
+            let y24: f64 = lay.enterprises(24).map(|e| w.output[e]).sum();
+            let s24: f64 = (0..ng).map(|g| m.inventory[24 * ng + g]).sum();
+            let pos: f64 = acc.pop.iter().chain(acc.enterprise.iter()).map(|&a| (w.ledger.money(a).max(0)) as f64 * 1e-4).sum();
+            line += &format!("\n t{t}: I{idx:.3} Y{y:.3} D/Q{:.2} p24pop {:.3e} p24ent {:.3e} p24mkt {:.3e} y24 {y24:.3e} S24 {s24:.3e} others{:?} pos {pos:.3e}",
+                pd / pq, pm(24), em(24), w.ledger.money(acc.market[24]) as f64 * 1e-4, others.len());
+        }
+    }
+    println!("KS {ks} PS {ps} NTB {ntb} | I[{imin:.3},{imax:.3}] Ymin {ymin:.3} |{line}");
+}
